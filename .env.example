# Red Room environment. Copy to .env and fill in. Never commit .env.

# Mistral (all AI in the product is Mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL_MAIN=mistral-large-4
MISTRAL_MODEL_FALLBACK=mistral-small-2603
MISTRAL_MODERATION_MODEL=mistral-moderation-2603
MISTRAL_EMBED_MODEL=mistral-embed
VOXTRAL_STT_REALTIME_MODEL=voxtral-mini-transcribe-realtime-3-0
VOXTRAL_STT_BATCH_MODEL=voxtral-mini-transcribe-3-0
VOXTRAL_TTS_MODEL=voxtral-mini-tts-3-0
# Sample rate of response_format=pcm output (raw float32 LE mono) for live playback
VOXTRAL_TTS_SAMPLE_RATE=24000
# Preset voice IDs from GET /v1/audio/voices (Sheila, Margaret, James, Rob, Paul variants)
VOXTRAL_VOICE_AVA=
VOXTRAL_VOICE_MAX=
VOXTRAL_VOICE_PIP=

# Database (backend is the only writer; SQLite file is git-ignored)
DATABASE_URL=sqlite:///./redroom.db

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Run limits (v4): voice 300 s; text 20 player messages or 600 s; idle 60 s
RUN_VOICE_S=300
RUN_TEXT_S=600
RUN_TEXT_MESSAGES=20
RUN_IDLE_S=60

# App wiring
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
ADMIN_PLAYER_IDS=

# Chain (Base Sepolia testnet only)
CHAIN_RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
BOUNTY_OWNER_PRIVATE_KEY=
CHONK_TOKEN_ADDRESS=
BOUNTY_VAULT_ADDRESS=
